# Set with supabase secrets set --env-file .env (never commit .env).
NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-20b
GITHUB_TOKEN=
GITHUB_OWNER=connectraunakt-gif
# Exact Clay origin, without a path. Local preview can be added comma-separated.
CLAY_ORIGINS=https://connectraunakt-gif.github.io,http://localhost:4173
GITHUB_REPOSITORY=Clay

# Google OAuth Web application credentials (optional until configured).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
